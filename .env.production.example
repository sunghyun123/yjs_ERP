# .env.production.example
# VPS에서 이 파일을 복사하여 실제 값으로 채우세요:
#   cp .env.production.example .env.production
#
# Next.js는 NODE_ENV=production일 때 .env.production을 자동으로 로드합니다.
# 이 파일(.env.production.example)은 git에 포함됩니다.
# 실제 키가 담긴 .env.production은 절대 git에 커밋하지 마세요.

# ── Supabase ──────────────────────────────────────────────
# Supabase 프로젝트 대시보드 → Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key: RLS 우회 (마이그레이션 및 카카오 화이트리스트 자동 동기화용)
# 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것 — 브라우저에 노출됨
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 대시보드에서 승인된 카카오 계정을 ERP 화이트리스트에 자동 추가
# yjs_Dashboard의 ERP_DASHBOARD_API_KEY와 같은 값을 사용
DASHBOARD_API_KEY=replace_with_shared_dashboard_api_key
DASHBOARD_ACCESS_CHECK_URL=https://yjsboard.com/api/auth/erp-access-check

# DB 백업용 Postgres 연결 문자열 (supabase db dump 전용, 서버에서만 사용)
# Supabase 대시보드 → Settings → Database → Connection string (URI) 에서 확인
# 예: postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── Next.js ───────────────────────────────────────────────
# PM2 ecosystem.config.js의 PORT와 반드시 일치시킬 것
PORT=3001

# Analytics (PostHog)
# Client-visible project token and host. Do not put private API keys here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only salt used to hash Supabase user.id before PostHog identify/capture.
# Use a long random value in production and never expose it to the browser.
POSTHOG_USER_HASH_SALT=replace_with_long_random_secret
