# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env*.example

# private source/business data
/*.xlsx
/scripts/failed_rows.json

# backup evidence tiers
/backups/private/*
!/backups/private/README.md
/backups/reproducible/generated/*
!/backups/reproducible/generated/.gitkeep
/backups/portfolio/generated/*
!/backups/portfolio/generated/.gitkeep
/docs/*.generated.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorm sessions
.superpowers/

